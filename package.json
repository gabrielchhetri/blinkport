{
  "name": "blinkport",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node --env-file-if-exists=.env.local scripts/launch-preflight.mjs --build",
    "build": "next build",
    "prestart": "node --env-file-if-exists=.env.local scripts/launch-preflight.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/paste-store.test.mjs",
    "launch:check": "node --env-file-if-exists=.env.local scripts/launch-preflight.mjs --verify-redis"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "@vercel/analytics": "^2.0.1",
    "next": "^16.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.4.6",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "^1.1.21"
    }
  }
}
